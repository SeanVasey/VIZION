# =====================================================================
# VIZION — environment template.  Copy to `.env.local` and fill in.
# NEVER commit real values. `.env*.local` is gitignored.
# =====================================================================

# --- Supabase (P2+) -------------------------------------------------
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS, NEVER expose to the client:
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner console (2026-08) — server-side only ----------------------
# The account email allowed to claim the owner console (Settings → Owner:
# open/close access, developer-accent strength). Case-insensitive. Unset =
# no owner console anywhere (fails closed).
OWNER_EMAIL=

# --- Model providers (P3+) — server-side only -----------------------
# These keys must never reach the client. They are read exclusively
# inside Next route handlers (the provider-adapter proxy). Every key must
# also be added to the Vercel project env; until it is set, that
# provider's targets return 503 "not configured" (the rest keep working).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
# The 2026-07 sixteen-model roster:
DEEPSEEK_API_KEY=      # DeepSeek V4 (platform.deepseek.com)
META_API_KEY=          # Muse Spark 1.1 (Meta Model API, api.meta.ai — replaces LLAMA_API_KEY)
MINIMAX_API_KEY=       # MiniMax M3 (platform.minimax.io)
MOONSHOT_API_KEY=      # Kimi K3 (platform.moonshot.ai)
PERPLEXITY_API_KEY=    # Sonar Pro (perplexity.ai/settings/api)
DASHSCOPE_API_KEY=     # Qwen3.8 Max (Alibaba Cloud Model Studio, intl region)
ZAI_API_KEY=           # GLM-5.2 (Z.ai open platform, z.ai/model-api)

# Model strings per target (overridable — keeps the adapter version-agnostic, D9).
# Defaults: claude-opus-5 / claude-sonnet-5 / gpt-5.6-sol / gpt-5.6-luna
# / gpt-5.6-terra / claude-fable-5 / deepseek-v4-pro / gemini-3.6-flash
# / muse-spark-1.1 / MiniMax-M3 / mistral-large-latest / kimi-k3 / sonar-pro
# / qwen3.8-max / grok-4.5 / glm-5.2.
# Gemini note: "Thinking" and "Fast" in Google's app are thinkingLevel values
# on the ONE `gemini-3.6-flash` model (exposed in-app via the thinking
# selector). There is no `gemini-3.6-thinking` model string — pointing
# MODEL_GEMINI at one would 404 the target.
MODEL_OPUS=
MODEL_SONNET=
MODEL_GPT=
MODEL_GPT_LUNA=
MODEL_GPT_TERRA=
MODEL_FABLE=
MODEL_DEEPSEEK=
MODEL_GEMINI=
MODEL_MUSE=
MODEL_MINIMAX=
MODEL_MISTRAL=
MODEL_KIMI=
MODEL_SONAR=
MODEL_QWEN=
MODEL_GROK=
MODEL_GLM=
# Optional USD-per-1M-token pricing overrides used for the cost cap.
PRICE_OPUS_IN=
PRICE_OPUS_OUT=
PRICE_SONNET_IN=
PRICE_SONNET_OUT=
PRICE_GPT_IN=
PRICE_GPT_OUT=
PRICE_GPT_LUNA_IN=
PRICE_GPT_LUNA_OUT=
PRICE_GPT_TERRA_IN=
PRICE_GPT_TERRA_OUT=
PRICE_FABLE_IN=
PRICE_FABLE_OUT=
PRICE_DEEPSEEK_IN=
PRICE_DEEPSEEK_OUT=
PRICE_GEMINI_IN=
PRICE_GEMINI_OUT=
PRICE_MUSE_IN=
PRICE_MUSE_OUT=
PRICE_MINIMAX_IN=
PRICE_MINIMAX_OUT=
PRICE_MISTRAL_IN=
PRICE_MISTRAL_OUT=
PRICE_KIMI_IN=
PRICE_KIMI_OUT=
PRICE_SONAR_IN=
PRICE_SONAR_OUT=
PRICE_QWEN_IN=
PRICE_QWEN_OUT=
PRICE_GROK_IN=
PRICE_GROK_OUT=
# GLM-5.2 list rates unpublished — defaults are the GLM-5 reference rates.
PRICE_GLM_IN=
PRICE_GLM_OUT=

# --- Per-user cost caps & rate limits (P3+) -------------------------
# Enforced server-side on every model route.
COST_CAP_USD_PER_DAY=2.00
RATE_LIMIT_PER_MIN=20

# --- Provider connection policy (P3+) -------------------------------
# Two clocks, deliberately. PROVIDER_IDLE_MS is time since the LAST TOKEN:
# a stream that keeps producing is never interrupted however long it runs,
# and one that goes quiet this long is dead. PROVIDER_TOTAL_MS is only a
# backstop and MUST stay under the enhance route's maxDuration (300s), or
# the platform kills the function before the spend hold is settled.
# These replaced a single 55s whole-request deadline that capped healthy
# generations at ~2-4k output tokens and billed the truncated result.
PROVIDER_IDLE_MS=60000
PROVIDER_TOTAL_MS=285000
# /api/media is a bounded one-shot under a maxDuration=60 route, so it keeps
# a flat whole-request deadline. Separate on purpose.
MEDIA_TIMEOUT_MS=55000

# Output ceiling for Qwen only — the tightest in the fleet. DashScope 400s
# above its published range, so raise this only from the vendor's model page.
MAX_TOKENS_QWEN=8192

# --- Media (P5) -----------------------------------------------------
# Extraction pipeline: "proxy" (vision via the model proxy, default) or
# "ondevice" (fast, private, limited). Proxy needs ANTHROPIC_API_KEY.
NEXT_PUBLIC_MEDIA_EXTRACTION=proxy
