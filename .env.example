# =====================================================================
# VIZION — environment template.  Copy to `.env.local` and fill in.
# NEVER commit real values. `.env*.local` is gitignored.
# =====================================================================

# --- Site (public) --------------------------------------------------
# Canonical origin used as `metadataBase` for absolute Open Graph / Twitter
# card URLs. Optional — defaults to the production domain
# (https://vizion-io.vercel.app) when unset. Set per preview/prod deploy so
# the share card resolves to the right host.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (P2+) -------------------------------------------------
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS, NEVER expose to the client:
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner console (2026-08) — server-side only ----------------------
# The account email allowed to claim the owner console (Settings → Owner:
# open/close access, developer-accent strength). Case-insensitive. Unset =
# no owner console anywhere (fails closed).
OWNER_EMAIL=

# --- Model providers (P3+) — server-side only -----------------------
# These keys must never reach the client. They are read exclusively
# inside Next route handlers (the provider-adapter proxy). Every key must
# also be added to the Vercel project env; until it is set, that
# provider's targets return 503 "not configured" (the rest keep working).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
# The twenty-one-model roster (2026-11-28 frontier re-verify). Its four new
# slots ride keys that already existed (Haiku 5.5 on ANTHROPIC_API_KEY, Gemini
# 4 Carbon + Neon on GOOGLE_API_KEY, Muse Wonder 1.0 on META_API_KEY) — no new
# key is required.
DEEPSEEK_API_KEY=      # DeepSeek V4 Pro (platform.deepseek.com)
META_API_KEY=          # Muse Wonder 1.0 + Muse Spark 1.3 (Meta Model API, api.meta.ai — replaces LLAMA_API_KEY)
MINIMAX_API_KEY=       # MiniMax M3.1 Flash (platform.minimax.io)
MOONSHOT_API_KEY=      # Kimi K3.1 Pro (platform.moonshot.ai)
PERPLEXITY_API_KEY=    # Sonar Pro (perplexity.ai/settings/api) — legacy chat endpoint, sunset 2026-09-27, still answering
DASHSCOPE_API_KEY=     # Qwen4 Max (Alibaba Cloud Model Studio, international scope)
ZAI_API_KEY=           # GLM-5.3 (Z.ai open platform, z.ai/model-api)

# Qwen's OpenAI-compatible base URL. Leave unset for the shared host
# (https://dashscope-intl.aliyuncs.com/compatible-mode/v1). Alibaba is moving
# this API to a per-workspace host; set this when your workspace is moved:
# QWEN_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Model strings per target (overridable — keeps the adapter version-agnostic, D9).
# Leave a line blank for the default: a blank value is read as unset.
# Defaults (2026-11-28): claude-fable-5-2 / claude-opus-5-5 / claude-sonnet-5-5
# / claude-haiku-5-5 / gpt-6.2-astra / gpt-6.2-sol / gpt-6.1-terra / gpt-6-luna
# / deepseek-v4-pro / gemini-4-carbon / gemini-4-neon / gemini-4-hydrogen
# / muse-wonder-1.0 / muse-spark-1.3 / MiniMax-M3.1-Flash / mistral-large-4-0
# / kimi-k3.1-pro / sonar-pro / qwen4-max / grok-4.7 / glm-5.3.
# AN OVERRIDE OUTLIVES A ROSTER MOVE: the slot keeps its variable name, so a
# deployment still setting MODEL_OPUS=claude-opus-5 keeps calling Opus 5 under
# the Opus 5.5 label and price. After a roster bump, clear every MODEL_* and
# PRICE_* you no longer mean (docs/runbooks/providers.md).
# Two names to read carefully: MODEL_GPT / PRICE_GPT_* are GPT-6.2 Sol, and
# MODEL_GEMINI / PRICE_GEMINI_* are Gemini 4 Hydrogen (the old Flash slot).
# Gemini note: "Thinking" and "Fast" in Google's app are thinkingLevel values
# on one model (exposed in-app via the thinking dial), not model strings —
# pointing a MODEL_GEMINI* variable at an invented "-thinking" id would 404
# the target. Carbon, Neon and Hydrogen ARE three separate model strings.
MODEL_FABLE=
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL_GPT_ASTRA=
MODEL_GPT=
MODEL_GPT_TERRA=
MODEL_GPT_LUNA=
MODEL_DEEPSEEK=
MODEL_GEMINI_CARBON=
MODEL_GEMINI_NEON=
MODEL_GEMINI=
MODEL_MUSE_WONDER=
MODEL_MUSE=
MODEL_MINIMAX=
MODEL_MISTRAL=
MODEL_KIMI=
MODEL_SONAR=
MODEL_QWEN=
MODEL_GROK=
MODEL_GLM=
# Optional USD-per-1M-token pricing overrides. Used for the cost cap AND for
# Auto's cost ranking (manifest.ts reads live prices) — an override changes
# which model Auto picks under Balanced/Budget, not just the daily-cap math.
# Defaults re-verified against vendor pages 2026-11-28 (config.ts comments
# carry the per-row sources and caveats). Gemini 4 Carbon defaults to its
# $4/$20 BASE rate; the $2/$10 introductory rate ends 2026-11-30.
PRICE_FABLE_IN=
PRICE_FABLE_OUT=
PRICE_OPUS_IN=
PRICE_OPUS_OUT=
PRICE_SONNET_IN=
PRICE_SONNET_OUT=
PRICE_HAIKU_IN=
PRICE_HAIKU_OUT=
PRICE_GPT_ASTRA_IN=
PRICE_GPT_ASTRA_OUT=
PRICE_GPT_IN=
PRICE_GPT_OUT=
PRICE_GPT_TERRA_IN=
PRICE_GPT_TERRA_OUT=
PRICE_GPT_LUNA_IN=
PRICE_GPT_LUNA_OUT=
PRICE_DEEPSEEK_IN=
PRICE_DEEPSEEK_OUT=
PRICE_GEMINI_CARBON_IN=
PRICE_GEMINI_CARBON_OUT=
PRICE_GEMINI_NEON_IN=
PRICE_GEMINI_NEON_OUT=
PRICE_GEMINI_IN=
PRICE_GEMINI_OUT=
PRICE_MUSE_WONDER_IN=
PRICE_MUSE_WONDER_OUT=
PRICE_MUSE_IN=
PRICE_MUSE_OUT=
PRICE_MINIMAX_IN=
PRICE_MINIMAX_OUT=
PRICE_MISTRAL_IN=
PRICE_MISTRAL_OUT=
PRICE_KIMI_IN=
PRICE_KIMI_OUT=
PRICE_SONAR_IN=
PRICE_SONAR_OUT=
PRICE_QWEN_IN=
PRICE_QWEN_OUT=
PRICE_GROK_IN=
PRICE_GROK_OUT=
PRICE_GLM_IN=
PRICE_GLM_OUT=

# --- Per-user cost caps & rate limits (P3+) -------------------------
# Enforced server-side on every model route.
COST_CAP_USD_PER_DAY=2.00
RATE_LIMIT_PER_MIN=20

# --- Provider connection policy (P3+) -------------------------------
# Two clocks, deliberately. PROVIDER_IDLE_MS is time since the LAST TOKEN:
# a stream that keeps producing is never interrupted however long it runs,
# and one that goes quiet this long is dead. PROVIDER_TOTAL_MS is only a
# backstop and MUST stay under the enhance route's maxDuration (300s), or
# the platform kills the function before the spend hold is settled.
# These replaced a single 55s whole-request deadline that capped healthy
# generations at ~2-4k output tokens and billed the truncated result.
PROVIDER_IDLE_MS=60000
PROVIDER_TOTAL_MS=285000
# /api/media is a bounded one-shot under a maxDuration=60 route, so it keeps
# a flat whole-request deadline. Separate on purpose.
MEDIA_TIMEOUT_MS=55000

# Output ceiling for Qwen. Unset, the adapter sends 32000 and steps up to
# 64000 on the High/Max tier; set, this caps BOTH. Leave unset unless your
# account's scope serves a lower range than the published one — Qwen4-Max's
# ceiling is 131,072 non-thinking / 262,144 thinking, and the cap covers
# thinking AND answer together. Do not copy the old 8192 forward: that was
# qwen3.7-max's ceiling, and a model that spends its cap on thinking first
# truncates under it. A value outside the served range 400s every call.
# MAX_TOKENS_QWEN=

# --- Media (P5) -----------------------------------------------------
# Extraction pipeline: "proxy" (vision via the model proxy, default) or
# "ondevice" (fast, private, limited). Proxy needs ANTHROPIC_API_KEY.
NEXT_PUBLIC_MEDIA_EXTRACTION=proxy
